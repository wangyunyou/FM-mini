# 开发环境模板 —— 本文件会提交，只放通用默认值与占位，不放密钥、不放真实 AppID。
# 个人真实值写到 .env.development.local：已被 .gitignore 的 *.local 忽略，Taro 会自动用它覆盖同名变量。
# 改完任何 env 都要重新执行 pnpm dev:weapp 才生效。

# FM 后端本地地址（mvn spring-boot:run -Dspring-boot.run.profiles=dev 默认 8080）
TARO_APP_API_BASE_URL=http://localhost:8080

# 开发者工具本地调试用 touristappid 即可，这里留空
TARO_APP_ID=

# 真机预览时手机访问不到开发机的 localhost，需要换成开发机的局域网 IP，
# 建议写在 .env.development.local 里而不是改本文件：
# TARO_APP_API_BASE_URL=http://<开发机局域网IP>:8080
